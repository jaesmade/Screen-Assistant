{
  "name": "screen-study-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "A screen-based study coach for practice and AI-permitted assessments.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node build/generate-icons.cjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:electron": "node tests/run-electron-smoke.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test:packaged": "node tests/run-packaged-smoke.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "eventsource-parser": "^4.1.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "lucide-react": "^1.49.0",
    "katex": "^0.19.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "author": "jaesmade",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaesmade/Screen-Assistant.git"
  }
}
